# ==============================================================================
# MSIT BUG HUNT - ENVIRONMENT VARIABLES
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
# The secure PIN code required to log into the /admin dashboard.
# Change this in production to a strong alphanumeric string.
ADMIN_PIN="123456"

# ------------------------------------------------------------------------------
# 2. NOTION DATABASE INTEGRATION
# ------------------------------------------------------------------------------
# Your internal integration token from notion.so/my-integrations
NOTION_TOKEN="secret_your_notion_internal_integration_token"

# Database IDs extracted from the Notion URLs
NOTION_DATABASE_BUGS_ID="your_bugs_db_id"
NOTION_DATABASE_STUDENTS_ID="your_students_db_id"
NOTION_DATABASE_ORIENTATIONS_ID="your_orientations_db_id"
NOTION_DATABASE_BADGES_ID="your_badges_db_id"

# ------------------------------------------------------------------------------
# 3. GOOGLE DRIVE STORAGE (Screenshots)
# ------------------------------------------------------------------------------
# The ID of the Google Drive folder where screenshots will be uploaded.
# (Extracted from the URL of the folder: drive.google.com/drive/folders/ID)
# Make sure this folder is shared with the Service Account email!
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id"

# The stringified JSON of your Google Cloud Service Account credentials.
# Make sure it is compressed into a single line if necessary.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"...","universe_domain":"googleapis.com"}'
